# App
MODE=DEV
DEBUG=true
PROJECT_NAME=EasyClaims

# Database
POSTGRES_SERVER=0.0.0.0
POSTGRES_USER=mystique_agents
POSTGRES_PASSWORD=mystique_agents
POSTGRES_DB=easyclaims
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# Auth (JWE) - Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWE_SECRET_KEY=your-32-byte-hex-secret-here
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=86400

# X-API-Key
API_KEY=your-internal-api-key-here
X_API_KEY_PATHS=  # Comma-separated path prefixes requiring X-API-Key

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Email provider — "resend" or "gmail" (SMTP)
EMAIL_PROVIDER=resend

# SMTP (used when EMAIL_PROVIDER=gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@easyclaims.com
SMTP_TLS=true

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=EasyClaims <developer@easyclaims.in>

# Middleware
REQUEST_TIMEOUT_SECONDS=30
API_RATE_LIMIT=60
API_RATE_PERIOD=60
RATE_LIMIT_EXCLUDED_PATHS=  # Comma-separated paths excluded from rate limiting

# Security
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=  # Leave blank for localhost; set to .yourdomain.com in production
COOKIE_SECURE=false
SAMESITE_MODE=lax
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false

# Logging
LOG_LEVEL=DEBUG
LOG_TO_FILE=false
LOG_FILE_PATH=easyclaims.logs

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Meta WhatsApp Cloud API — from Meta Business Suite > WhatsApp Manager > API Setup
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# System User access token (System Users > your system user), scopes:
# whatsapp_business_messaging, whatsapp_business_management
META_WHATSAPP_ACCESS_TOKEN=your-access-token
# App Dashboard > Settings > Basic > App Secret (verifies X-Hub-Signature-256)
META_WHATSAPP_APP_SECRET=your-app-secret
# Any string you choose — must match what you enter in Meta's webhook config UI
META_WHATSAPP_VERIFY_TOKEN=change_me_verify_token
META_WHATSAPP_API_VERSION=v20.0
# WABA ID — not required for sending; kept for future template management
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
