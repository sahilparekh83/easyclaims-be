# ─────────────────────────────────────────────────────────────────────────────
# EasyClaims Backend — Environment Sample
# Copy to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
MODE=DEV                        # DEV | TEST | PROD
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=easyclaims
POSTGRES_PASSWORD=change_me
POSTGRES_DB=easyclaims_dev
POSTGRES_SSL_MODE=disable       # disable | require | verify-ca | verify-full

# ── Auth / JWE ────────────────────────────────────────────────────────────────
# Must be exactly 32 bytes (256-bit) for A256GCM. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWE_SECRET_KEY=change_me_32_byte_hex_secret_here_000000000000000000000000000000
ACCESS_TOKEN_EXPIRE_SECONDS=1800      # 30 min
REFRESH_TOKEN_EXPIRE_SECONDS=86400    # 24 h

# ── Internal API Key ─────────────────────────────────────────────────────────
# Used for machine-to-machine calls on X_API_KEY_PATHS
API_KEY=change_me_internal_api_key
X_API_KEY_PATHS=/api/v1/internal

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── Email provider — "resend" or "gmail" (SMTP) ────────────────────────────────
EMAIL_PROVIDER=resend

# ── SMTP (used when EMAIL_PROVIDER=gmail) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@easyclaims.in

# ── Resend (used when EMAIL_PROVIDER=resend) ───────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=EasyClaims <developer@easyclaims.in>

# ── File Storage ──────────────────────────────────────────────────────────────
# STORAGE_BACKEND controls which backend is used: local | gcs | azure
STORAGE_BACKEND=local

# Local (DEV only) — files stored on disk under UPLOAD_DIR/
UPLOAD_DIR=uploads

# ── Google Cloud Storage (STORAGE_BACKEND=gcs) ────────────────────────────────
STORAGE_BUCKET=easyclaims-policies
GCS_PROJECT=your-gcp-project-id
# Path to service account JSON key file.
# Leave empty to use Application Default Credentials (recommended for GCP VMs).
GCS_CREDENTIALS_FILE=/path/to/service-account.json

# ── Azure Blob Storage (STORAGE_BACKEND=azure) ────────────────────────────────
AZURE_CONTAINER=policies
# Full connection string from Azure Portal → Storage Account → Access Keys
AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net

# ── Rate Limiting ─────────────────────────────────────────────────────────────
API_RATE_LIMIT=60               # requests per period
API_RATE_PERIOD=60              # period in seconds
RATE_LIMIT_EXCLUDED_PATHS=/api/v1/health,/api/v1/auth/send-otp

# ── Request Timeout ───────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
# Optional: regex pattern for dynamic origins, e.g. https://.*\.easyclaims\.in
# CORS_ORIGIN_REGEX=

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false             # true in PROD (HTTPS only)
SAMESITE_MODE=lax               # lax | strict | none
# COOKIE_DOMAIN=.easyclaims.in

# ── Security Headers ──────────────────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false              # true in PROD
HSTS_MAX_AGE=31536000
FRAME_OPTIONS=SAMEORIGIN
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=accelerometer=(), autoplay=(), camera=(), geolocation=(), microphone=(), payment=()
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG                 # DEBUG | INFO | WARNING | ERROR
LOG_TO_FILE=false
LOG_FILE_PATH=easyclaims.logs

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# From Meta Business Suite > WhatsApp Manager > API Setup
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# System User access token (System Users > your system user), scopes:
# whatsapp_business_messaging, whatsapp_business_management
META_WHATSAPP_ACCESS_TOKEN=your-access-token
# App Dashboard > Settings > Basic > App Secret (verifies X-Hub-Signature-256)
META_WHATSAPP_APP_SECRET=your-app-secret
# Any string you choose — must match what you enter in Meta's webhook config UI
META_WHATSAPP_VERIFY_TOKEN=change_me_verify_token
META_WHATSAPP_API_VERSION=v20.0
# WABA ID — not required for sending; kept for future template management
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
